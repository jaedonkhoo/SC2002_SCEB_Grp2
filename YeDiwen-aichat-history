package domain;

import enums.CustomerStatus;

/**
 * 顾客类 (Customer)
 * 记录顾客 ID、满意度、生命周期状态及绑定的订单信息
 */
public class Customer {
    // 1. 私有成员变量 (封装)
    private final int id;               // 顾客编号 (如 Customer #1, #2)
    private int satisfaction;           // 实时满意度 (初始 100)
    private CustomerStatus status;      // 当前状态
    private Order order;                // 绑定的订单对象 (未点餐前为 null)
    private int turnServed;             // 记录送达时的回合数 (用于判定用餐时长)

    /**
     * 构造函数：顾客生成时自动加入等待队列
     * @param id 顾客编号
     */
    public Customer(int id) {
        this.id = id;
        this.satisfaction = 100; // 初始满意度固定为 100
        this.status = CustomerStatus.WAITING_IN_QUEUE;
        this.order = null;
        this.turnServed = -1;
    }

    // 2. Getter 与 Setter 方法

    public int getId() {
        return id;
    }

    public int getSatisfaction() {
        return satisfaction;
    }

    public CustomerStatus getStatus() {
        return status;
    }

    public void setStatus(CustomerStatus status) {
        this.status = status;
    }

    public Order getOrder() {
        return order;
    }

    public void setOrder(Order order) {
        this.order = order;
    }

    public int getTurnServed() {
        return turnServed;
    }

    public void setTurnServed(int turnServed) {
        this.turnServed = turnServed;
    }

    /**
     * 扣减满意度（每回合在队列或在座未送餐扣 8 点，最低降至 0）
     * @param points 扣除的点数
     */
    public void decreaseSatisfaction(int points) {
        this.satisfaction = Math.max(0, this.satisfaction - points);
    }

    /**
     * 判断顾客是否因为满意度降至 0 而放弃等待离店
     */
    public boolean isUnhappyAndLeaves() {
        return satisfaction <= 0;
    }

    @Override
    public String toString() {
        String orderInfo = (order == null) ? "No Order" : order.getMenuItem().getName() + " (" + order.getStatus() + ")";
        return String.format("Customer #%d [Sat: %d, Status: %s, Order: %s]",
                id, satisfaction, status, orderInfo);
    }
}

三、 核心设计要点
满意度扣减逻辑（decreaseSatisfaction）：
在 Step 5（Waiting and abandonment）阶段，未送餐的顾客扣除 8 点满意度。使用 Math.max(0, ...) 保证满意度不会出现负数。
送餐回合标记（turnServed）：
记录顾客被送餐的具体回合，这样 Step 4 才能判断“已送餐满 1 个完整回合”的顾客何时转为 READY_TO_PAY 准备结账。
状态与订单联动：
刚生成时 order 为 null；侍应生取单后将 Order 对象绑定给顾客，并随着烹饪和送餐不断更新其状态。

