package domain;

/**
 * 菜品类 (MenuItem)
 * 代表菜单上的某一项菜品（如 Salad, Burger, Pasta）
 */
public class MenuItem {
    // 1. 私有成员变量（Attributes）
    private final String name;                // 菜品名称（如 "Salad"）
    private final int priceInCents;           // 菜品价格（以美分表示，如 $9.00 为 900）
    private final int prepUnitsRequired;      // 厨师烹饪所需的制作单位数（如 1 或 2）

    /**
     * 构造函数（Constructor）
     * @param name 菜品名称
     * @param priceInCents 价格（美分）
     * @param prepUnitsRequired 所需制作单位数
     */
    public MenuItem(String name, int priceInCents, int prepUnitsRequired) {
        this.name = name;
        this.priceInCents = priceInCents;
        this.prepUnitsRequired = prepUnitsRequired;
    }

    // 2. Getter 方法（获取私有变量的值）

    public String getName() {
        return name;
    }

    public int getPriceInCents() {
        return priceInCents;
    }

    public int getPrepUnitsRequired() {
        return prepUnitsRequired;
    }

    /**
     * 将美分价格格式化为美元字符串（如 900 -> "$9.00"）
     */
    public String getFormattedPrice() {
        return String.format("$%.2f", priceInCents / 100.0);
    }

    /**
     * 重写 toString() 方法，方便控制台打印菜品信息
     */
    @Override
    public String toString() {
        return String.format("%s (%s, %d prep unit%s)",
                name,
                getFormattedPrice(),
                prepUnitsRequired,
                prepUnitsRequired > 1 ? "s" : "");
    }
}

三、 属性与方法逐行解释
属性（Fields）：
name：菜品的名称，如 "Salad"、"Burger"、"Pasta"。
priceInCents：价格（美分表示），例如 Salad 是 $9.00 则传入 900，Burger 是 $15.00 则传入 1500，Pasta 是 $18.00 则传入 1800。
prepUnitsRequired：厨师制作该菜品所需的轮次/单位数，Salad 和 Burger 各需 1 单位，Pasta 需 2 单位。
使用 final 修饰符：因为菜品的基础属性创建后不应该在运行中被随意修改，符合不变性（Immutability）原则。
方法（Methods）：
构造函数 MenuItem(...)：初始化上述三个基础属性。
getFormattedPrice()：辅助 UI 展示，自动将 900 美分除以 100 转换成 "$9.00" 格式。
toString()：打印格式如 Pasta ($18.00, 2 prep units)，可以直接用在 CLI 面板打印上。

