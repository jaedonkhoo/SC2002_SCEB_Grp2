package controller;

import domain.*;
import enums.*;
import staff.*;

import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;

/**
 * 游戏核心控制器 (GameController)
 * 负责维护 18 个回合的流转及每回合 6 个步骤的规则校验与状态更新
 */
public class GameController {
    // 基础设定常量 (根据作业基准参数设定)
    public static final int MAX_TURNS = 18;                     // 最大 18 个回合
    public static final int TABLE_COUNT = 2;                    // 2 张餐桌
    public static final int TARGET_PAID_CUSTOMERS = 4;          // 目标付费顾客 >= 4 人
    public static final int TARGET_REVENUE_CENTS = 4500;        // 目标营业额 >= $45.00 (4500 美分)
    public static final double TARGET_AVG_SATISFACTION = 60.0;  // 目标平均满意度 >= 60.0

    // 回合运行指标与计数器
    private int currentTurn;
    private int totalRevenueInCents; // 金额以整数美分存储，避免浮点精度误差
    private int nextCustomerId;
    private int nextOrderId;

    // 容器与角色对象
    private final List<Customer> waitingQueue;
    private final List<Table> tables;
    private final List<Customer> paidCustomers;
    private final List<Customer> allCustomersCreated;
    private final List<Order> activeOrders;

    private final Menu menu;
    private final Waiter waiter;
    private final Chef chef;
    private final Cashier cashier;

    /**
     * 构造函数：初始化地图结构、人员角色与数据容器
     */
    public GameController() {
        this.currentTurn = 1;
        this.totalRevenueInCents = 0;
        this.nextCustomerId = 1;
        this.nextOrderId = 1;

        this.waitingQueue = new ArrayList<>();
        this.tables = new ArrayList<>();
        for (int i = 1; i <= TABLE_COUNT; i++) {
            tables.add(new Table(i));
        }

        this.paidCustomers = new ArrayList<>();
        this.allCustomersCreated = new ArrayList<>();
        this.activeOrders = new ArrayList<>();

        this.menu = new Menu();
        this.waiter = new Waiter();
        this.chef = new Chef();
        this.cashier = new Cashier();
    }

    // =========================================================================
    // 基础信息获取与指标统计
    // =========================================================================

    public int getCurrentTurn() { return currentTurn; }
    public int getTotalRevenueInCents() { return totalRevenueInCents; }

    /**
     * 获取格式化的显示金额 (如 "$45.00")
     */
    public String getFormattedRevenue() {
        return String.format("$%.2f", totalRevenueInCents / 100.0);
    }

    /**
     * 计算已付费离店顾客的平均满意度
     */
    public double getAverageSatisfaction() {
        if (paidCustomers.isEmpty()) return -1.0;
        int sum = 0;
        for (Customer c : paidCustomers) {
            sum += c.getSatisfaction();
        }
        return (double) sum / paidCustomers.size();
    }

    public String getFormattedAverageSatisfaction() {
        double avg = getAverageSatisfaction();
        return (avg < 0) ? "N/A" : String.format("%.1f", avg);
    }

    public List<Customer> getWaitingQueue() { return waitingQueue; }
    public List<Table> getTables() { return tables; }
    public List<Customer> getPaidCustomers() { return paidCustomers; }
    public List<Order> getActiveOrders() { return activeOrders; }

    // =========================================================================
    // 每回合 6 个步骤的核心业务逻辑
    // =========================================================================

    /**
     * 步骤 1: Arrivals (顾客到达)
     * 在第 1, 4, 7, 10, 13, 16 回合各产生 1 位普通顾客 (初始满意度 100)
     */
    public void step1_Arrivals() {
        // 重置所有员工本回合的忙碌标记
        waiter.resetTurn();
        chef.resetTurn();
        cashier.resetTurn();

        // 判定固定的顾客到达回合
        if (currentTurn == 1 || currentTurn == 4 || currentTurn == 7 ||
            currentTurn == 10 || currentTurn == 13 || currentTurn == 16) {
            Customer c = new Customer(nextCustomerId++);
            waitingQueue.add(c);
            allCustomersCreated.add(c);
        }
    }

    // 步骤 2 动作合法性校验方法
    public boolean validateWaiterSeat(int customerId, int tableId) {
        Customer target = getCustomerInQueueById(customerId);
        Table t = getTableById(tableId);
        return target != null && t != null && t.isAvailable();
    }

    public boolean validateWaiterTakeOrder(int customerId) {
        Customer c = getSeatedCustomerById(customerId);
        return c != null && c.getOrder() == null;
    }

    public boolean validateWaiterServe(int orderId) {
        Order o = getOrderById(orderId);
        if (o == null || o.getStatus() != OrderStatus.READY) return false;
        Customer c = getCustomerByOrder(o);
        // 本回合刚制作完成的菜品，最早只能在下一个回合被侍应生送达
        return c != null && c.getStatus() == CustomerStatus.SEATED;
    }

    public boolean validateChefCook(int orderId) {
        Order o = getOrderById(orderId);
        return o != null && (o.getStatus() == OrderStatus.PENDING || o.getStatus() == OrderStatus.IN_PREPARATION);
    }

    /**
     * 步骤 2: Manager Choices (执行玩家决定的侍应生与厨师任务)
     */
    public void executeTurnActions(WaiterAction wAction, Integer wTargetId, Integer wTableId, ChefAction cAction, Integer cOrderId) {
        // 1. 侍应生先行动
        if (wAction == WaiterAction.SEAT) {
            Customer c = getCustomerInQueueById(wTargetId);
            Table t = getTableById(wTableId);
            waiter.seatCustomer(c, t);
            waitingQueue.remove(c);
        } else if (wAction == WaiterAction.TAKE_ORDER) {
            Customer c = getSeatedCustomerById(wTargetId);
            Order o = waiter.takeOrder(c, menu, nextOrderId++);
            if (o != null) activeOrders.add(o);
        } else if (wAction == WaiterAction.SERVE) {
            Order o = getOrderById(wTargetId);
            Customer c = getCustomerByOrder(o);
            waiter.serveOrder(c, currentTurn);
        }

        // 2. 厨师后行动 (厨师可以烹饪侍应生在本回合刚刚录入的新订单)
        if (cAction == ChefAction.COOK) {
            Order o = getOrderById(cOrderId);
            chef.cookOrder(o);
        }
    }

    /**
     * 步骤 4: Eating and payment (用餐与自动结账)
     */
    public void step4_EatingAndPayment() {
        // 在上一回合或更早拿到菜品的顾客，本回合吃完饭并转化为 READY_TO_PAY 状态
        for (Customer c : allCustomersCreated) {
            if (c.getStatus() == CustomerStatus.SERVED && c.getTurnServed() < currentTurn) {
                c.setStatus(CustomerStatus.READY_TO_PAY);
            }
        }

        // 收银员每回合自动处理最早就绪的 1 位顾客结账
        Customer toPay = null;
        for (Customer c : allCustomersCreated) {
            if (c.getStatus() == CustomerStatus.READY_TO_PAY) {
                toPay = c;
                break;
            }
        }

        if (toPay != null) {
            Table t = getTableByCustomer(toPay);
            int paid = cashier.processPayment(toPay, t);
            totalRevenueInCents += paid;
            paidCustomers.add(toPay);
            if (toPay.getOrder() != null) activeOrders.remove(toPay.getOrder());
        }
    }

    /**
     * 步骤 5: Waiting and abandonment (扣减满意度与未送餐离店清算)
     */
    public void step5_WaitingAndAbandonment() {
        // 回合结束时，队列中或在座未送餐的顾客扣除 8 点满意度
        for (Customer c : allCustomersCreated) {
            if (c.getStatus() == CustomerStatus.WAITING_IN_QUEUE || c.getStatus() == CustomerStatus.SEATED) {
                c.decreaseSatisfaction(8);
            }
        }

        // 队列中满意度降为 0 的顾客离店
        Iterator<Customer> qIter = waitingQueue.iterator();
        while (qIter.hasNext()) {
            Customer c = qIter.next();
            if (c.isUnhappyAndLeaves()) {
                c.setStatus(CustomerStatus.LEFT_UNHAPPY);
                qIter.remove();
            }
        }

        // 餐桌上满意度降为 0 的顾客离店，取消未完成订单并清空释放餐桌
        for (Table t : tables) {
            if (!t.isAvailable()) {
                Customer c = t.getOccupiedCustomer();
                if (c.isUnhappyAndLeaves()) {
                    c.setStatus(CustomerStatus.LEFT_UNHAPPY);
                    if (c.getOrder() != null) {
                        c.getOrder().setStatus(OrderStatus.PAID);
                        activeOrders.remove(c.getOrder());
                    }
                    t.releaseTable();
                }
            }
        }
    }

    // =========================================================================
    // 回合推进与胜负判定
    // =========================================================================

    public void advanceTurn() { currentTurn++; }
    public boolean isGameOver() { return currentTurn > MAX_TURNS; }

    /**
     * 检查是否达成胜利条件：
     * 必须同时满足：付费顾客 >= 4 人 AND 营业额 >= $45.00 AND 平均满意度 >= 60.0
     */
    public boolean isVictory() {
        return paidCustomers.size() >= TARGET_PAID_CUSTOMERS &&
               totalRevenueInCents >= TARGET_REVENUE_CENTS &&
               getAverageSatisfaction() >= TARGET_AVG_SATISFACTION;
    }

    // =========================================================================
    // 内部查找辅助方法
    // =========================================================================

    public Table getTableById(int id) {
        for (Table t : tables) if (t.getTableId() == id) return t;
        return null;
    }

    public Customer getCustomerInQueueById(int id) {
        for (Customer c : waitingQueue) if (c.getId() == id) return c;
        return null;
    }

    public Customer getSeatedCustomerById(int id) {
        for (Table t : tables) {
            if (!t.isAvailable() && t.getOccupiedCustomer().getId() == id) return t.getOccupiedCustomer();
        }
        return null;
    }

    public Order getOrderById(int id) {
        for (Order o : activeOrders) if (o.getOrderId() == id) return o;
        return null;
    }

    public Customer getCustomerByOrder(Order order) {
        for (Customer c : allCustomersCreated) if (c.getOrder() == order) return c;
        return null;
    }

    public Table getTableByCustomer(Customer c) {
        for (Table t : tables) if (!t.isAvailable() && t.getOccupiedCustomer() == c) return t;
        return null;
    }
}

三、 重点规则与代码映射解析
顾客固定到达计划 (step1_Arrivals)：
按照规则，顾客只会在第 1, 4, 7, 10, 13, 16 回合加入队列，总计 6 位顾客。第 16 回合到达的顾客由于时间不足无法在 18 回合内结账，因此实际最多能结账 5 位顾客。
美分存储与财务计算 (totalRevenueInCents)：
所有价格在代码中均以整数美分计算（例如 $45.00 存储为 4500），避免浮点运算精度损失。
满意度扣减与未送餐离店 (step5_WaitingAndAbandonment)：
普通顾客在未送餐前，每回合扣除 8 点满意度。一旦降至 0（isUnhappyAndLeaves()），顾客放弃等待并离店，对应餐桌被自动清空，未完成的订单从活动列表中剔除。
胜利目标校验 (isVictory)：
在第 18 回合结束时检查：付费顾客人数 \(\ge 4\)、总营业额 \(\ge $45.00\) 且平均满意度 \(\ge 60.0\) 三者必须同时满足才能获得胜利。

