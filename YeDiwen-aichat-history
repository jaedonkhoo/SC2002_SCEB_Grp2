package enums;

/**
 * 顾客生命周期状态枚举 (CustomerStatus)
 */
public enum CustomerStatus {
    /**
     * 在队列等待：顾客到达餐厅后加入等待队列。
     * 初始满意度为 100，每回合未送餐会扣减 8 点满意度。
     */
    WAITING_IN_QUEUE,

    /**
     * 已入座：侍应生将其安排到空餐桌上。
     * 此时等待侍应生取单，或等待厨师烹饪/侍应生送餐；每回合未送餐同样扣减 8 点满意度。
     */
    SEATED,

    /**
     * 已送餐：侍应生成功将烹饪完成（READY）的菜品送达餐桌。
     * 此时满意度停止扣减，顾客开始用餐。
     */
    SERVED,

    /**
     * 准备结账：已送餐的顾客用餐满 1 个完整回合后进入此状态。
     * 等待收银员自动处理结账（每回合收银员自动处理 1 位最早就绪的顾客）。
     */
    READY_TO_PAY,

    /**
     * 已支付：收银员成功收取账款，账款计入总收入，顾客离开餐厅并清空释放餐桌。
     */
    PAID,

    /**
     * 不满意离开：顾客在队列或餐桌等待期间满意度降至 0。
     * 顾客直接离店且不付款，未完成的订单被取消，餐桌被释放。
     */
    LEFT_UNHAPPY
}

