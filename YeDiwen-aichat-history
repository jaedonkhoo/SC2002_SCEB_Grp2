package domain;

/**
 * 餐桌类 (Table)
 * 代表餐厅中的一张餐桌，负责维护餐桌编号及绑定的顾客对象
 */
public class Table {
    // 1. 私有成员变量 (封装)
    private final int tableId;             // 餐桌编号 (如 Table 1, Table 2)
    private Customer occupiedCustomer;     // 当前入座的顾客对象 (无人入座时为 null)

    /**
     * 构造函数：初始化餐桌，默认状态为空闲
     * @param tableId 餐桌编号
     */
    public Table(int tableId) {
        this.tableId = tableId;
        this.occupiedCustomer = null; // 初始时餐桌为空
    }

    // 2. Getter 与状态查询方法

    public int getTableId() {
        return tableId;
    }

    public Customer getOccupiedCustomer() {
        return occupiedCustomer;
    }

    /**
     * 判断餐桌当前是否空闲可用
     * @return 若无顾客占用则返回 true
     */
    public boolean isAvailable() {
        return occupiedCustomer == null;
    }

    /**
     * 安排顾客入座
     * @param customer 被指派入座的顾客对象
     */
    public void seatCustomer(Customer customer) {
        this.occupiedCustomer = customer;
    }

    /**
     * 清空并释放餐桌（顾客结账付款离开或满意度归零离店时调用）
     */
    public void releaseTable() {
        this.occupiedCustomer = null;
    }

    @Override
    public String toString() {
        if (isAvailable()) {
            return String.format("Table %d: [EMPTY]", tableId);
        } else {
            return String.format("Table %d: [Occupied by %s]", tableId, occupiedCustomer);
        }
    }
}

3. 代码关键要点解析
空闲状态判定（isAvailable）：
当 occupiedCustomer == null 时说明餐桌空闲。侍应生在执行安排入座（SEAT）指令前，会先调用此方法校验该餐桌是否能够坐人。
餐桌的生命周期流转：
侍应生安排入座：侍应生执行 SEAT 动作，调用 table.seatCustomer(customer) 将顾客绑定到餐桌上。
结账或不满意离开：收银员完成结账（PAID）或者顾客满意度跌至 0 离店（LEFT_UNHAPPY）时，系统调用 table.releaseTable() 将 occupiedCustomer 重新设为 null，释放餐桌供下一位顾客使用。

