package staff;

import domain.*;
import enums.*;

/**
 * 收银员类 (Cashier)
 * 继承自 Staff 父类，负责在 Step 4 自动处理顾客结账与餐桌释放
 */
public class Cashier extends Staff {

    /**
     * 构造函数：初始化收银员角色名称为 "Cashier"
     */
    public Cashier() {
        super("Cashier");
    }

    /**
     * 执行结账动作 (processPayment)
     * 收银员每回合最多自动为 1 位处于 READY_TO_PAY 状态的顾客处理结账
     *
     * @param customer 待结账的顾客对象
     * @param table 该顾客占用的餐桌对象
     * @return 成功结账返回收取的账款金额（美分）；无法结账则返回 0
     */
    public int processPayment(Customer customer, Table table) {
        // 校验：顾客必须存在且处于 READY_TO_PAY 状态
        if (customer == null || customer.getStatus() != CustomerStatus.READY_TO_PAY) {
            return 0;
        }

        // 1. 获取顾客绑定的菜品价格（美分）
        Order order = customer.getOrder();
        int amountPaidInCents = order.getMenuItem().getPriceInCents();

        // 2. 更新订单与顾客状态为 PAID
        order.setStatus(OrderStatus.PAID);
        customer.setStatus(CustomerStatus.PAID);

        // 3. 释放被占用的餐桌
        if (table != null) {
            table.releaseTable();
        }

        // 4. 标记收银员本回合已忙碌
        setBusyThisTurn(true);

        // 返回本次收取的账款金额（用于累加进总收入）
        return amountPaidInCents;
    }
}

三、 核心代码逐块解析与规则对照
自动结账触发机制 (processPayment)：
按照规则，在上一回合或更早拿到菜品（SERVED）的顾客，会在本回合用餐完毕并自动切换为 READY_TO_PAY 状态。
控制器会在 Step 4 自动找出最早就绪的 1 位顾客，并传给 cashier.processPayment(...) 处理。
金额计算与防浮点数误差：
账款金额通过 order.getMenuItem().getPriceInCents() 获取（美分单位，如 Salad 存储为 900 美分，即 $9.00）。这严格遵从了作业中“小数金额必须以美分存储”的规范。
资源释放（清空餐桌）：
调用 table.releaseTable() 将餐桌重新设为空闲状态（occupiedCustomer = null），使等待队列中的下一位顾客可以在随后的回合里入座。

