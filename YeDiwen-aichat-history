package domain;

import enums.OrderStatus;

/**
 * 订单类 (Order)
 * 记录订单编号、关联菜品、已完成的制作单位以及当前订单状态
 */
public class Order {
    // 1. 私有属性 (Encapsulated Attributes)
    private final int orderId;             // 订单唯一编号
    private final MenuItem menuItem;       // 绑定的菜品 (如 Salad, Burger, Pasta)
    private int prepUnitsCompleted;        // 厨师已推进的制作单位数 (初始为 0)
    private OrderStatus status;            // 当前订单状态

    /**
     * 构造函数：当侍应生执行 TAKE_ORDER 时创建订单
     * @param orderId 订单编号
     * @param menuItem 顾客选择的菜品
     */
    public Order(int orderId, MenuItem menuItem) {
        this.orderId = orderId;
        this.menuItem = menuItem;
        this.prepUnitsCompleted = 0;
        this.status = OrderStatus.PENDING; // 初始状态为待处理
    }

    // 2. Getter 与 Setter 方法

    public int getOrderId() {
        return orderId;
    }

    public MenuItem getMenuItem() {
        return menuItem;
    }

    public int getPrepUnitsCompleted() {
        return prepUnitsCompleted;
    }

    /**
     * 获取该菜品所需的总制作单位数（例如 Salad 需 1 个单位，Pasta 需 2 个单位）
     */
    public int getPrepUnitsRequired() {
        return menuItem.getPrepUnitsRequired();
    }

    public OrderStatus getStatus() {
        return status;
    }

    public void setStatus(OrderStatus status) {
        this.status = status;
    }

    /**
     * 厨师烹饪时调用：推进 1 个制作单位，并更新订单状态
     */
    public void advancePreparation() {
        if (prepUnitsCompleted < getPrepUnitsRequired()) {
            prepUnitsCompleted++;

            // 刚开始烹饪时，状态变为 IN_PREPARATION
            if (prepUnitsCompleted == 1 && status == OrderStatus.PENDING) {
                status = OrderStatus.IN_PREPARATION;
            }

            // 当推进到最后一个制作单位时，订单自动变为 READY
            if (prepUnitsCompleted >= getPrepUnitsRequired()) {
                status = OrderStatus.READY;
            }
        }
    }

    /**
     * 判断订单是否已完全制作完成
     */
    public boolean isFullyPrepared() {
        return prepUnitsCompleted >= getPrepUnitsRequired();
    }

    @Override
    public String toString() {
        return String.format("Order #%d [%s] (%d/%d units) - %s",
                orderId,
                menuItem.getName(),
                prepUnitsCompleted,
                getPrepUnitsRequired(),
                status);
    }
}

三、 状态转换与规则详解
组合关系与制作单位：
Order 类组合了 MenuItem 类。当顾客点选 Salad 或 Burger 时，所需制作单位为 1；点选 Pasta 时，所需制作单位为 2。
状态流转机制（advancePreparation()）：
初始阶段：侍应生取单后，状态为 PENDING（已完成 0 单位）。
烹饪阶段：厨师执行 COOK 操作，prepUnitsCompleted 加 1。状态由 PENDING 变为 IN_PREPARATION。
完成阶段：当 prepUnitsCompleted 达到所需的总单位数时，订单状态自动变为 READY。
送餐限制与规则：
按照规则，本回合刚变为 READY 的菜品，侍应生最快只能在下一个回合进行送达（SERVE），送达后状态变为 SERVED。

