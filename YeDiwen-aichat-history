package staff;

import domain.*;
import enums.*;

/**
 * 侍应生类 (Waiter)
 * 继承自 Staff 父类，实现安排入座、取单与送餐等业务逻辑
 */
public class Waiter extends Staff {

    /**
     * 构造函数：初始化侍应生角色名称为 "Waiter"
     */
    public Waiter() {
        super("Waiter");
    }

    /**
     * 任务 1：安排入座 (SEAT)
     * @param customer 队列中的顾客
     * @param table 目标餐桌
     * @return 若成功入座返回 true，否则返回 false
     */
    public boolean seatCustomer(Customer customer, Table table) {
        // 校验：必须处于等待队列中，且目标餐桌必须空闲
        if (customer.getStatus() != CustomerStatus.WAITING_IN_QUEUE || !table.isAvailable()) {
            return false;
        }

        table.seatCustomer(customer);
        customer.setStatus(CustomerStatus.SEATED);
        setBusyThisTurn(true); // 标记侍应生本回合已忙碌
        return true;
    }

    /**
     * 任务 2：取单 (TAKE_ORDER)
     * @param customer 已入座的顾客
     * @param menu 菜单对象
     * @param nextOrderId 待分配的新订单 ID
     * @return 创建成功返回 Order 对象，失败返回 null
     */
    public Order takeOrder(Customer customer, Menu menu, int nextOrderId) {
        // 校验：顾客必须已入座且当前尚未点餐
        if (customer.getStatus() != CustomerStatus.SEATED || customer.getOrder() != null) {
            return null;
        }

        // 按照菜单的自主选餐规则自动选择菜品
        MenuItem selectedItem = menu.selectFoodForCustomer(customer.getId());
        Order newOrder = new Order(nextOrderId, selectedItem);
        customer.setOrder(newOrder); // 绑定订单给顾客

        setBusyThisTurn(true); // 标记侍应生本回合已忙碌
        return newOrder;
    }

    /**
     * 任务 3：送餐 (SERVE)
     * @param customer 目标顾客
     * @param currentTurn 当前游戏回合数
     * @return 送餐成功返回 true，失败返回 false
     */
    public boolean serveOrder(Customer customer, int currentTurn) {
        // 校验：顾客必须已入座且持有订单
        if (customer.getStatus() != CustomerStatus.SEATED || customer.getOrder() == null) {
            return false;
        }

        Order order = customer.getOrder();
        // 校验：订单必须处于 READY 状态 (做好的菜)
        if (order.getStatus() != OrderStatus.READY) {
            return false;
        }

        // 更新订单与顾客状态
        order.setStatus(OrderStatus.SERVED);
        customer.setStatus(CustomerStatus.SERVED);
        customer.setTurnServed(currentTurn); // 记录送达时的回合数

        setBusyThisTurn(true); // 标记侍应生本回合已忙碌
        return true;
    }
}

三、 核心代码逐块解析
继承结构 (extends Staff)：
通过 super("Waiter") 调用父类构造函数，继承了父类中管理员工名称与 busyThisTurn 忙碌标记的成员变量与方法。
状态校验防御 (seatCustomer / takeOrder / serveOrder)：
每个方法最开头都做了严格的前置条件检查（例如餐桌是否可用 table.isAvailable()、菜品是否为 OrderStatus.READY）。不合法的动作直接返回 false 或 null，确保无效操作不会损坏游戏内部状态。
与领域对象的协作 (Domain Interaction)：
在 takeOrder 中调用 menu.selectFoodForCustomer(...) 实现顾客自主选菜，并将生成的 Order 对象绑定给顾客。
在 serveOrder 中调用 customer.setTurnServed(currentTurn) 记录送达时间戳，为后续判断顾客用餐时长提供依据。

