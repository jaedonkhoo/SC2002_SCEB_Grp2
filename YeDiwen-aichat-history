package domain;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

/**
 * 菜单类 (Menu)
 * 负责维护餐厅的所有菜品，并执行“顾客自主选餐”逻辑
 */
public class Menu {
    // 私有属性：存储菜单项列表（使用 List<MenuItem> 组合组合关系）
    private final List<MenuItem> items;

    /**
     * 构造函数：初始化 Stage 1 的 3 种固定菜品
     */
    public Menu() {
        items = new ArrayList<>();
        // 价格以美分存储：$9.00 -> 900, $15.00 -> 1500, $18.00 -> 1800
        items.add(new MenuItem("Salad", 900, 1));
        items.add(new MenuItem("Burger", 1500, 1));
        items.add(new MenuItem("Pasta", 1800, 2));
    }

    /**
     * 获取不可修改的菜品列表（防止外部代码随意篡改菜单）
     * @return 只读菜品列表
     */
    public List<MenuItem> getItems() {
        return Collections.unmodifiableList(items);
    }

    /**
     * 顾客自主选餐规则（确定性分配逻辑，符合作业 2.2 节要求）：
     * 根据顾客 ID 轮询选菜：
     * - Customer #1 -> Salad ($9.00, 1 unit)
     * - Customer #2 -> Burger ($15.00, 1 unit)
     * - Customer #3 -> Pasta ($18.00, 2 units)
     * - Customer #4 -> Salad ... 以此类推
     *
     * @param customerId 顾客的 ID
     * @return 顾客所选的 MenuItem 对象
     */
    public MenuItem selectFoodForCustomer(int customerId) {
        int index = (customerId - 1) % items.size();
        return items.get(index);
    }
}

三、 代码核心亮点解析
组合关系（Composition）：
Menu 类内部持有一个 List<MenuItem> 列表。这体现了面向对象中的“组合”原则，菜单包含多个菜品对象。
防防御性封装（Defensive Encapsulation）：
getItems() 返回了 Collections.unmodifiableList(items)，确保 UI 或 Controller 只能读取菜单，不能从外部随意添加或删除菜品。
符合确定性点餐规范：
selectFoodForCustomer(int customerId) 使用 (customerId - 1) % items.size() 的公式。这样每次测试运行的选餐顺序完全一致，方便你生成**可复现（reproducible）**的胜利和失败运行测试记录。

