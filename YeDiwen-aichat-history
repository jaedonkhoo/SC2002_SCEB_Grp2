package enums;

/**
 * 订单状态枚举 (OrderStatus)
 */
public enum OrderStatus {
    /**
     * 待处理：侍应生刚为入座顾客完成点餐，订单已创建，但尚未开始烹饪（完成单位为 0）。
     */
    PENDING,

    /**
     * 烹饪中：厨师已对该订单推进了制作单位，但尚未达到菜品所需的总制作单位。
     * （例如 Pasta 需要 2 个制作单位，厨师完成第 1 个单位后处于此状态）。
     */
    IN_PREPARATION,

    /**
     * 制作完成：厨师完成了菜品的最后一个制作单位。
     * 注意：本回合刚制作完成的菜品，最快只能在下一个回合被侍应生送达。
     */
    READY,

    /**
     * 已送达：侍应生执行送餐任务，将 READY 状态的菜品送给顾客。
     */
    SERVED,

    /**
     * 已结清/已取消：收银员完成账款收取，或者顾客因满意度归零离店后订单被取消。
     */
    PAID
}

